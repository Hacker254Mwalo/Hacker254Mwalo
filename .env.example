# ── Supabase (required for real auth & data) ──────────────────────────────────
VITE_SUPABASE_URL=https://qlzfhogkbfsipmrurbfo.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
# Optional: service role key for the webhook to bypass RLS (set server-side only)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── Admin ─────────────────────────────────────────────────────────────────────
# Admin identity is managed via the users table (is_admin flag).
# WhatsApp support settings are configured in Admin > Settings tab.

# ── Zetu Pay M-Pesa STK Push (Base64 authorizationKey per request) ───────────
# Credentials from https://www.zetupay.co.ke/docs/authentication
# Get these from the Merchant Portal > Developers tab of your application
ZETUPAY_PUBLIC_KEY=your-zetupay-public-key      # pk_live_... or pk_test_...
ZETUPAY_SECRET_KEY=your-zetupay-secret-key      # sk_live_... or sk_test_...
ZETUPAY_WALLET_ID=your-zetupay-app-id            # appId from your merchant app

# Base API URL — the /api/v1 path is appended by the code
ZETUPAY_BASE_URL=https://pay.zetupay.co.ke/api/v1

# Fully-qualified redirect URL — the customer returns here after checkout
ZETUPAY_REDIRECT_URL=https://your-app.vercel.app

# Full public URL of the webhook endpoint (this exact path on your Vercel app)
# e.g. https://your-app.vercel.app/api/webhooks/zetupay
ZETUPAY_CALLBACK_URL=https://your-app.vercel.app/api/webhooks/zetupay
