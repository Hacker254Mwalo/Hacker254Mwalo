# ── Supabase (required for real auth & data) ──────────────────────────────────
VITE_SUPABASE_URL=https://qlzfhogkbfsipmrurbfo.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
# Optional: service role key for the callback to bypass RLS (set server-side only)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── Admin ─────────────────────────────────────────────────────────────────────
# Admin identity is managed via the users table (is_admin flag).
# WhatsApp support settings are configured in Admin > Settings tab.

# ── PayKit M-Pesa STK Push (OAuth2 client_credentials) ───────────────────────
# Credentials from https://developer.paykit.africa
PAYKIT_CLIENT_ID=your-paykit-client-id
PAYKIT_CLIENT_SECRET=your-paykit-client-secret

# Base API URL — switch to https://api.paykit.co.ke for production
PAYKIT_BASE_URL=https://api.sandbox.paykit.africa

# Full public URL of the callback endpoint (this exact path on your Vercel app)
# e.g. https://your-app.vercel.app/api/stk-callback
PAYKIT_CALLBACK_URL=https://your-app.vercel.app/api/stk-callback
