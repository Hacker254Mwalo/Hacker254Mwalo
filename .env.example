# ── Supabase (required for real auth & data) ──────────────────────────────────
VITE_SUPABASE_URL=https://jwnhluxftefqciwomqig.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
# Optional: service role key for the callback to bypass RLS (set server-side only)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── Clerk Authentication ───────────────────────────────────────────────────────
# Get these from https://dashboard.clerk.com → Your App → API Keys
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your-clerk-publishable-key
CLERK_SECRET_KEY=sk_test_your-clerk-secret-key

# ── Admin ─────────────────────────────────────────────────────────────────────
# Set to your phone number (e.g. +254712345678) to access the admin panel
VITE_ADMIN_PHONE=+254712345678

# ── PayKit M-Pesa STK Push ────────────────────────────────────────────────────
# Sandbox credentials (from https://developer.paykit.africa)
PAYKIT_CONSUMER_KEY=your-paykit-consumer-key
PAYKIT_CONSUMER_SECRET=your-paykit-consumer-secret
PAYKIT_PASSKEY=your-paykit-passkey

# Sandbox: 174379  |  Production: your Paybill number (e.g. 4091165)
PAYKIT_SHORTCODE=174379

# Sandbox base URL — switch to https://api.paykit.co.ke for production
PAYKIT_BASE_URL=https://api.sandbox.paykit.africa

# Derived automatically from PAYKIT_BASE_URL; override only if needed:
# PAYKIT_AUTH_URL=https://api.sandbox.paykit.africa/oauth/v1/generate?grant_type=client_credentials
# PAYKIT_STK_URL=https://api.sandbox.paykit.africa/v1/collection/stkpush

# Full public URL of your deployment — used to build the callback URL
# e.g. https://your-app.vercel.app  (no trailing slash)
PAYKIT_CALLBACK_URL=https://your-app.vercel.app/api/stk-callback
