{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "crons": [
    {
      "path": "/api/daily-profits",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/process-short-term",
      "schedule": "0 * * * *"
    }
  ]
}
